# ---- 江城万物怪 · 环境变量示例 ----
# 复制成 .env 后填写。.env 不要提交到仓库。
#
# 有 Key：服务端代理模型调用，前端显示「实时 AI」；
# 无 Key：自动进入「演示模式」，本地规则生成，全流程可玩。

# 任意 OpenAI 兼容的 chat/completions 服务
AI_PROVIDER=openai-compatible
AI_API_BASE_URL=https://maas.whu.edu.cn/v1
# 实测可读图的模型：deepseek-v4-flash / glm-5.3-flash / qwen3.7-plus
AI_MODEL=deepseek-v4-flash
AI_API_KEY=

# 有些兼容服务不支持 response_format=json_object，可设为 off
AI_JSON_MODE=on

# 关闭演示模式会禁止无 Key 时的本地生成（不推荐）
DEMO_MODE_ENABLED=true

PORT=8787
